set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass

break *0x1001da50
commands
  silent
  set $text = *(unsigned int *)($esp + 8)
  disable 1
  set $tag = (char *)malloc(32)
  set {char[32]}$tag = "vtspeak-lipunits-@SPEED@"
  set $lip = ((unsigned int (*)(char *, char *, int, int, int, int, int, int, int))0x1001de50)((char *)$text, $tag, 1, -1, @SPEED@, -1, -1, -1, -1)
  printf "LIPSYNC_SPEED speed=@SPEED@ tag=vtspeak-lipunits-@SPEED@ raw_eax=%#x signed=%d\n", $lip, $lip

  set $allocation = (char *)malloc(60032)
  set $buffer = $allocation + 16
  set $length = (int *)malloc(4)
  set $total = 0
  set $poll = 0
  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, 0, 0, -1, @SPEED@, -1, -1, -1, 0)
  set $total = $total + *$length
  while ($result == 0) && ($poll < 16)
    set *$length = 60000
    set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 1, 0, 1, 0, 0, -1, @SPEED@, -1, -1, -1, 0)
    set $total = $total + *$length
    set $poll = $poll + 1
  end
  printf "LIPSYNC_PCM_CONTROL speed=@SPEED@ result=%d polls=%d bytes=%d frames=%d\n", $result, $poll, $total, $total / 2
  continue
end

continue
