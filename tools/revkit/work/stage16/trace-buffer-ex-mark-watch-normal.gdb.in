set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass
set $mark_watch_set = 0

break *0x1002efd0
commands
  silent
  if $mark_watch_set == 0
    set $ctx = *(unsigned int *)($esp + 28)
    set $desc = *(unsigned int *)($ctx + 0x122448)
    set $row_index = *(int *)$desc
    if $row_index == 1
      set $rows = *(unsigned int *)($desc + 4)
      set $row = $rows + $row_index * 0x210
      set $mark_watch_set = 1
      printf "MARK_WATCH_ARM row=%d address=%#x f0=%#x f4=%#x\n", $row_index, $row, *(unsigned int *)$row, *(unsigned int *)($row + 4)
      watch *(unsigned int *)$row
      commands 3
        silent
        printf "MARK_WATCH_WRITE field=+0 eip=%#x value=%#x\n", $eip, *(unsigned int *)$row
        disable 3
        continue
      end
      watch *(unsigned int *)($row + 4)
      commands 4
        silent
        printf "MARK_WATCH_WRITE field=+4 eip=%#x value=%#x\n", $eip, *(unsigned int *)($row + 4)
        disable 4
        continue
      end
    end
  end
  continue
end

break *0x1001cbad
commands
  silent
  if $mark_watch_set != 0
    set $desc = *(unsigned int *)($esi + 0x122448)
    set $count = *(int *)$desc
    set $rows = *(unsigned int *)($desc + 4)
    if $count > 1
      set $row = $rows + 0x210
      printf "MARK_WATCH_PIPELINE count=%d row1=%#x f0=%#x f4=%#x f8=%#x kind=%u\n", $count, $row, *(unsigned int *)$row, *(unsigned int *)($row + 4), *(unsigned int *)($row + 8), *(unsigned char *)($row + 0x20c)
    end
  end
  continue
end

continue
