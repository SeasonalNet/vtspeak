set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass

define ex_case
  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(@SELECTOR@, (char *)$text, $buffer, $length, 0, 0, 1, $sync_out, $records_out, $arg1, $arg2, $arg3, $arg4, $arg5, $arg6)
  printf "MARK_OPTION case=%d result=%d length=%d options=%d,%d,%d,%d,%d,%d\n", $arg0, $result, *$length, $arg1, $arg2, $arg3, $arg4, $arg5, $arg6
  set $desc = (char *)*$records_out
  set $count = *(int *)$desc
  set $rows = *(unsigned int *)($desc + 4)
  set $i = 0
  while $i < $count
    set $row = $rows + $i * 0x210
    printf "MARK_OPTION_ROW case=%d i=%d f0=%#x f4=%#x f8=%#x kind=%u\n", $arg0, $i, *(unsigned int *)$row, *(unsigned int *)($row + 4), *(unsigned int *)($row + 8), *(unsigned char *)($row + 0x20c)
    set $i = $i + 1
  end
  set $poll = 0
  while ($result == 0) && ($poll < 16)
    set *$length = 60000
    set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(@SELECTOR@, (char *)$text, $buffer, $length, 1, 0, 1, $sync_out, $records_out, $arg1, $arg2, $arg3, $arg4, $arg5, $arg6)
    set $poll = $poll + 1
  end
  printf "MARK_OPTION_DONE case=%d result=%d polls=%d\n", $arg0, $result, $poll
end

break *0x1001da50
commands
  silent
  set $text = *(unsigned int *)($esp + 8)
  disable 1
  set $allocation = (char *)malloc(60032)
  set $buffer = $allocation + 16
  set $length = (int *)malloc(4)
  set $sync_out = (unsigned int *)malloc(4)
  set $records_out = (unsigned int *)malloc(4)
  set $records_bytes = (char *)malloc(60000)
  set $sync_bytes = (char *)malloc(256)
  set $j = 0
  while $j < 60000
    set {unsigned char}($buffer + $j) = 0xa5
    set $j = $j + 1
  end
  set $j = 0
  while $j < 256
    set {unsigned char}($sync_bytes + $j) = 0xa5
    set $j = $j + 1
  end

  ex_case 0 -1 -1 -1 -1 0 0
  ex_case 1 50 -1 -1 -1 0 0
  ex_case 2 -1 50 -1 -1 0 0
  ex_case 3 -1 -1 0 -1 0 0
  ex_case 4 -1 -1 -1 250 0 0
  ex_case 5 200 400 500 65535 0 4
  ex_case 6 -1 -1 -1 -1 1023 0
  continue
end

continue
