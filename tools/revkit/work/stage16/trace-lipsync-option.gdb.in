set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass

break *0x1001da50
commands
  silent
  set $text = *(unsigned int *)($esp + 8)
  disable 1
  set $name = (char *)malloc(64)
  @INITIALIZE_NAME@
  printf "LIPSYNC_OPTION_CALL case=@CASE@\n"
  set $result = ((unsigned int (*)(char *, char *, int, int, int, int, int, int, int))0x1001de50)((char *)$text, $name, 1, @PITCH@, 100, @VOLUME@, @PAUSE@, @DICTIONARY@, @TYPE@)
  printf "LIPSYNC_OPTION case=@CASE@ raw_eax=%#x signed=%d\n", $result, $result
  continue
end

continue
