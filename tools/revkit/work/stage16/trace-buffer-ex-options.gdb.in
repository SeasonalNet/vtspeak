  printf "BUFFER_EX_OPTIONS case=volume_max pitch=-1 speed=-1 volume=500 pause=-1 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
    dump binary memory /work/stage16/buffer-ex-options-volume-max.bin $buffer $buffer+*$length
  end

  ex_poll
