  printf "BUFFER_EX_OPTIONS case=volume_min pitch=-1 speed=-1 volume=0 pause=-1 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
