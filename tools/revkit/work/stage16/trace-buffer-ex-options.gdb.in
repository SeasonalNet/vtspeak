  printf "BUFFER_EX_OPTIONS case=speed_below pitch=-1 speed=49 volume=-1 pause=-1 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
