  printf "BUFFER_EX_OPTIONS case=pause_zero pitch=-1 speed=-1 volume=-1 pause=0 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
    dump binary memory /work/stage16/buffer-ex-options-pause-zero.bin $buffer $buffer+*$length
  end

  ex_poll
  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, -1, -1, -1, 250, 0, 0)
  printf "BUFFER_EX_OPTIONS case=pause_250 pitch=-1 speed=-1 volume=-1 pause=250 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
    dump binary memory /work/stage16/buffer-ex-options-pause-250.bin $buffer $buffer+*$length
  end

  ex_poll
  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, -1, -1, -1, 65535, 0, 0)
  printf "BUFFER_EX_OPTIONS case=pause_max pitch=-1 speed=-1 volume=-1 pause=65535 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
    dump binary memory /work/stage16/buffer-ex-options-pause-max.bin $buffer $buffer+*$length
  end

  ex_poll
  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, -1, -1, -1, -1, 1023, 0)
  printf "BUFFER_EX_OPTIONS case=dict_1023 pitch=-1 speed=-1 volume=-1 pause=-1 dict=1023 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
    dump binary memory /work/stage16/buffer-ex-options-dict-1023.bin $buffer $buffer+*$length
  end

  ex_poll
  set $i = 0
  while $i < 8
    set *$length = 60000
    set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, -1, -1, -1, -1, 0, $i)
    printf "BUFFER_EX_OPTIONS case=texttype_%d pitch=-1 speed=-1 volume=-1 pause=-1 dict=0 texttype=%d result=%d length=%d\n", $i, $i, $result, *$length
    if (*$length > 0) && (*$length <= 60000)
      if $i == 0
        dump binary memory /work/stage16/buffer-ex-options-texttype-0.bin $buffer $buffer+*$length
      end
      if $i == 1
        dump binary memory /work/stage16/buffer-ex-options-texttype-1.bin $buffer $buffer+*$length
      end
      if $i == 2
        dump binary memory /work/stage16/buffer-ex-options-texttype-2.bin $buffer $buffer+*$length
      end
      if $i == 3
        dump binary memory /work/stage16/buffer-ex-options-texttype-3.bin $buffer $buffer+*$length
      end
      if $i == 4
        dump binary memory /work/stage16/buffer-ex-options-texttype-4.bin $buffer $buffer+*$length
      end
      if $i == 5
        dump binary memory /work/stage16/buffer-ex-options-texttype-5.bin $buffer $buffer+*$length
      end
      if $i == 6
        dump binary memory /work/stage16/buffer-ex-options-texttype-6.bin $buffer $buffer+*$length
      end
      if $i == 7
        dump binary memory /work/stage16/buffer-ex-options-texttype-7.bin $buffer $buffer+*$length
      end
    end
    ex_poll
    set $i = $i + 1
  end

  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, 200, 400, 500, 65535, 0, 4)
  printf "BUFFER_EX_OPTIONS case=texttype4_explicit pitch=200 speed=400 volume=500 pause=65535 dict=0 texttype=4 result=%d length=%d\n", $result, *$length
