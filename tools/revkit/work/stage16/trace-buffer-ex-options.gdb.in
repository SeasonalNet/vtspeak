set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass

define ex_poll
  set *$length = 60000
  set $poll_result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 1, 0, 1, (unsigned int *)0, (unsigned int *)0, -1, -1, -1, -1, 0, 0)
  printf "BUFFER_EX_OPTIONS poll result=%d length=%d\n", $poll_result, *$length
end

break *0x1001da50
commands
  silent
  set $text = *(unsigned int *)($esp + 8)
  disable 1
  set $buffer_alloc = (char *)malloc(60032)
  set $buffer = $buffer_alloc + 16
  set $length = (int *)malloc(4)
  set $i = 0
  while $i < 60000
    set {unsigned char}($buffer + $i) = 0xa5
    set $i = $i + 1
  end

  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, -1, -1, -1, -1, 0, 0)
  printf "BUFFER_EX_OPTIONS case=base pitch=-1 speed=-1 volume=-1 pause=-1 dict=0 texttype=0 result=%d length=%d\n", $result, *$length
  if (*$length > 0) && (*$length <= 60000)
    dump binary memory /work/stage16/buffer-ex-options-base.bin $buffer $buffer+*$length
  end

  ex_poll
  set *$length = 60000
  set $result = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(0, (char *)$text, $buffer, $length, 0, 0, 1, (unsigned int *)0, (unsigned int *)0, 50, -1, -1, -1, 0, 0)
