  printf "BUFFER_EX_DEEP_ERROR_NULL_BUFFER result=%d length=%d\n", $bad, *$length
  set *$length = 0x12345678
  set $bad = ((int (*)(int, char *, char *, int *, int, int, unsigned int, unsigned int *, unsigned int *, int, int, int, int, int, int))0x1001ddf0)(@SELECTOR@, $long_text, $buffer, $length, 0, 1, 1, $extra_a, $extra_b, -1, -1, -1, -1, 0, -1)
