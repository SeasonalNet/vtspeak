  printf "MAKEINFO_FOURTH_SWEEP case=ag-z-ULUL-question raw_eax=%#x text=%s path=%s\n", $raw_ag_z_ULUL_question, $text_ag_z_ULUL_question, $path_ag_z_ULUL_question
  kill
