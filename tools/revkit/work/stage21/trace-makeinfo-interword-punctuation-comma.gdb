  set {char}($path_zz_LL + 44) = 122
  set {char}($path_zz_LL + 45) = 122
  set {char}($path_zz_LL + 46) = 0
  set $raw_zz_LL = ((unsigned int (*)(char *, char *, int, int, int, int, int, int, int))0x1001de90)($text_zz_LL, $path_zz_LL, 1, -1, -1, -1, -1, -1, -1)
  printf "MAKEINFO_INTERWORD_PUNCT mark=comma case=zz-LL raw_eax=%#x text=%s path=%s\n", $raw_zz_LL, $text_zz_LL, $path_zz_LL
  kill
  quit
end

continue
