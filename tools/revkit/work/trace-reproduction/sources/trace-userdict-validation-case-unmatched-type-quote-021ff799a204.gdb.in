set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass

break *0x1001da50
commands
  silent
  disable 1
  set $valid_path = ((char *(*)(unsigned int))0x1001d9c0)(48)
#@bytes ["  set {char}($valid_path + ",0,") = ","5a3a2f776f726b2f737461676531362f75736572646963742d76616c69646174696f6e2d706c61696e2d702e63737600"]
  set $path_unmatched_type_quote = ((char *(*)(unsigned int))0x1001d9c0)(61)
#@bytes ["  set {char}($path_unmatched_type_quote + ",0,") = ","5a3a2f776f726b2f737461676531362f75736572646963742d76616c69646174696f6e2d756e6d6174636865642d747970652d71756f74652e63737600"]
  set $load_unmatched_type_quote = ((short (*)(int, char *))0x10027960)(100, $path_unmatched_type_quote)
  printf "USERDICT_MATRIX case=unmatched-type-quote index=100 load_ax=%d\n", $load_unmatched_type_quote
  set $unload_unmatched_type_quote = ((short (*)(int))0x10027a80)(100)
  printf "USERDICT_MATRIX case=unmatched-type-quote index=100 unload_ax=%d\n", $unload_unmatched_type_quote
  if $load_unmatched_type_quote != 1
    set $recover_unmatched_type_quote = ((short (*)(int, char *))0x10027960)(100, $valid_path)
    printf "USERDICT_MATRIX case=unmatched-type-quote index=100 valid_recovery_ax=%d\n", $recover_unmatched_type_quote
    if $recover_unmatched_type_quote == 1
      set $recover_unload_unmatched_type_quote = ((short (*)(int))0x10027a80)(100)
      printf "USERDICT_MATRIX case=unmatched-type-quote index=100 recovery_unload_ax=%d\n", $recover_unload_unmatched_type_quote
    end
  end
  continue
end

continue
