set pagination off
set confirm off
set debuginfod enabled off
handle SIGSEGV nostop noprint pass

break *0x1001da50
commands
  silent
  set $sample_speaker = *(int *)($esp + 16)
  disable 1
  set $dbroot = ((char *(*)(unsigned int))0x1001d9c0)(9)
#@bytes ["  set {char}($dbroot + ",0,") = ","5a3a2f776f726b2f00"]
  set $license = ((char *(*)(unsigned int))0x1001d9c0)(44)
#@bytes ["  set {char}($license + ",0,") = ","5a3a2f776f726b2f646174612d636f6d6d6f6e2f7665726966792f766572696669636174696f6e2e74787400"]
  set $p_csv = ((char *(*)(unsigned int))0x1001d9c0)(37)
#@bytes ["  set {char}($p_csv + ",0,") = ","5a3a2f776f726b2f737461676532312f6a616d65732d75736572646963742d702e63737600"]
  set $a_csv = ((char *(*)(unsigned int))0x1001d9c0)(43)
#@bytes ["  set {char}($a_csv + ",0,") = ","5a3a2f776f726b2f737461676532312f6a616d65732d75736572646963742d702d63692d63492e63737600"]
  set $control = ((char *(*)(unsigned int))0x1001d9c0)(58)
#@bytes ["  set {char}($control + ",0,") = ","5a3a2f776f726b2f737461676532312f6a616d65732d75736572646963742d63692d7461672d63492d636173652d636f6e74726f6c2e77617600"]
  set $p_output = ((char *(*)(unsigned int))0x1001d9c0)(52)
#@bytes ["  set {char}($p_output + ",0,") = ","5a3a2f776f726b2f737461676532312f6a616d65732d75736572646963742d63692d7461672d63492d636173652d702e77617600"]
  set $a_output = ((char *(*)(unsigned int))0x1001d9c0)(52)
#@bytes ["  set {char}($a_output + ",0,") = ","5a3a2f776f726b2f737461676532312f6a616d65732d75736572646963742d63692d7461672d63492d636173652d612e77617600"]
  set $restored = ((char *(*)(unsigned int))0x1001d9c0)(59)
#@bytes ["  set {char}($restored + ",0,") = ","5a3a2f776f726b2f737461676532312f6a616d65732d75736572646963742d63692d7461672d63492d636173652d726573746f7265642e77617600"]
  set $text = ((char *(*)(unsigned int))0x1001d9c0)(6)
#@bytes ["  set {char}($text + ",0,") = ","48454c4c4f00"]
  set $load_result = ((short (*)(void *, int, char *, unsigned int, unsigned int, char *, char *, unsigned int))0x10027af0)(0, 4, $dbroot, 0, 0xffffffff, $license, 0, 0xffffffff)
  set $slot_state = *(unsigned int *)(0x100a0464 + 16)
  set $gate = *(unsigned char *)(0x100a7488 + 4)
  set $capacity = 0
  if $slot_state != 0
    set $capacity = *(int *)($slot_state + 0x4d14)
  end
  printf "JAMES_DICT model_load_ax=%d sample_speaker=%d gate=%d capacity=%d\n", $load_result, $sample_speaker, $gate, $capacity
  set $baseline = ((short (*)(int, char *, char *, int, int, int, int, int, int, int))0x1001da50)(4, $text, $control, 4, -1, -1, -1, -1, 0, 0)
  printf "JAMES_DICT case=control synth=%d\n", $baseline
  set $load_p = ((short (*)(int, char *))0x10027960)(0, $p_csv)
  set $synth_p = ((short (*)(int, char *, char *, int, int, int, int, int, int, int))0x1001da50)(4, $text, $p_output, 4, -1, -1, -1, -1, 0, 0)
  set $unload_p = ((short (*)(int))0x10027a80)(0)
  printf "JAMES_DICT case=p load=%d synth=%d unload=%d\n", $load_p, $synth_p, $unload_p
  set $load_a = ((short (*)(int, char *))0x10027960)(0, $a_csv)
  set $synth_a = ((short (*)(int, char *, char *, int, int, int, int, int, int, int))0x1001da50)(4, $text, $a_output, 4, -1, -1, -1, -1, 0, 0)
  set $unload_a = ((short (*)(int))0x10027a80)(0)
  printf "JAMES_DICT case=a load=%d synth=%d unload=%d\n", $load_a, $synth_a, $unload_a
  set $restored_result = ((short (*)(int, char *, char *, int, int, int, int, int, int, int))0x1001da50)(4, $text, $restored, 4, -1, -1, -1, -1, 0, 0)
  printf "JAMES_DICT case=restored synth=%d\n", $restored_result
  call ((void (*)(int))0x10027ea0)(4)
  kill
  quit
end

continue
